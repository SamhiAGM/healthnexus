# Root .gitignore for HealthConnect LK Monorepo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Configs
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/.next/
frontend/out/
frontend/build/
frontend/node_modules/
.pnpm-debug.log*

# Java / Maven / Backend
backend/target/
backend/*.jar
backend/*.war
backend/.mvn/wrapper/maven-wrapper.jar
*.class

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs
logs/
*.log

# Docker / Local Test DB
docker/data/
mongo-data/
